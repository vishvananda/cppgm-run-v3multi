extern "C" int sink(const char *, ...);

enum NarrowEnum : unsigned char
{
  narrow_enum_value = 7
};

int variadic_promotions()
{
  bool boolean_value = true;
  char character_value = 1;
  signed char signed_character_value = 2;
  unsigned char unsigned_character_value = 3;
  short short_value = 4;
  unsigned short unsigned_short_value = 5;
  NarrowEnum enum_value = narrow_enum_value;
  float float_value = 1.0F;
  return sink("", boolean_value, character_value, signed_character_value,
    unsigned_character_value, short_value, unsigned_short_value,
    enum_value, float_value);
}

