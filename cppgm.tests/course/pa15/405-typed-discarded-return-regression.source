  }
}

void volatile_object_discard() {
  volatile int value = 0;
  value;
}

void volatile_reference_discard(volatile int &value) {
  value;
  for ((value = 1, value); value != 0; value = 0) {
  }
}

bool nested_runtime_logical() {
  return (runtime_gate() && true) || &kept_address;
}

bool nested_address_short_circuit() {
  return false && &omitted_address;
}

