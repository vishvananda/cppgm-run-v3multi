extern bool unavailable();
extern bool runtime_gate();
extern bool kept_address();
extern bool omitted_address();

bool empty_bool() { return {}; }
unsigned long empty_integral() { return {}; }
float empty_float() { return {}; }
double empty_double() { return {}; }
long double empty_long_double() { return {}; }
int *empty_pointer() { return {}; }

void void_to_void(int &value) {
  return static_cast<void>(static_cast<void>(value = 1));
}

bool logical_value() {
  return true || unavailable();
}

bool nested_logical_value() {
  return (true && false) && unavailable();
}

