function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  slot $values : obj<12x4>
  slot $p : ptr
  slot $paddr : ptr
  slot $ok_inc : i32
  slot $q : ptr
  slot $qaddr : ptr
  slot $ok_dec : i32
  slot $cond__1 : i32
  slot $land__2 : i64

  block ^entry:
    %t1 = addr $values
    %t2 = unary decay ptr %t1
    store ptr %t2, $p
    %t3 = addr $p
    store ptr %t3, $paddr
    %t4 = load ptr $p
    %t5 = binary mul i64 1, 4
    %t6 = index i8 %t4, %t5
    store ptr %t6, $p
    %t7 = addr $p
    %t8 = load ptr $paddr
    %t9 = cmp eq ptr %t7, %t8
    %t10 = convert trunc u8 i64 %t9
    %t11 = convert zext i32 u8 %t10
    store i32 %t11, $ok_inc
    %t12 = addr $values
    %t13 = unary decay ptr %t12
    %t14 = binary mul i64 2, 4
    %t15 = index i8 %t13, %t14
    store ptr %t15, $q
    %t16 = addr $q
    store ptr %t16, $qaddr
    %t17 = load ptr $q
    %t18 = binary mul i64 1, 4
    %t19 = binary sub i64 0, %t18
    %t20 = index i8 %t17, %t19
    store ptr %t20, $q
    %t21 = addr $q
    %t22 = load ptr $qaddr
    %t23 = cmp eq ptr %t21, %t22
    %t24 = convert trunc u8 i64 %t23
    %t25 = convert zext i32 u8 %t24
    store i32 %t25, $ok_dec
    %t26 = load i32 $ok_inc
    branch %t26, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t27 = load i32 $ok_dec
    %t28 = cmp ne i32 %t27, 0
    store i64 %t28, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t29 = load i64 $land__2
    branch %t29, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t30 = load i32 $cond__1
    return i32 %t30
}
