function @f() -> i32 [binding=strong, object=_Z1fv] {
  slot $x : i32
  slot $y : i32
  slot $b : u8
  slot $lor__1 : i64
  slot $land__2 : i64
  slot $cond__3 : i32

  block ^entry:
    store i32 0, $x
    store i32 1, $y
    %t1 = load i32 $x
    %t2 = cmp ne i32 %t1, 0
    %t3 = cmp eq i64 %t2, 0
    branch %t3, ^lor_short_2, ^lor_rhs_1

  block ^lor_rhs_1:
    %t4 = load i32 $y
    branch %t4, ^land_rhs_4, ^land_short_5

  block ^land_rhs_4:
    %t5 = cmp ne u8 1, 0
    store i64 %t5, $land__2
    jump ^land_end_6

  block ^land_short_5:
    store i64 0, $land__2
    jump ^land_end_6

  block ^land_end_6:
    %t6 = load i64 $land__2
    %t7 = cmp ne i64 %t6, 0
    store i64 %t7, $lor__1
    jump ^lor_end_3

  block ^lor_short_2:
    store i64 1, $lor__1
    jump ^lor_end_3

  block ^lor_end_3:
    %t8 = load i64 $lor__1
    %t9 = convert trunc u8 i64 %t8
    store u8 %t9, $b
    %t10 = load i32 $x
    %t11 = binary add i32 %t10, 1
    store i32 %t11, $x
    %t12 = load i32 $y
    %t13 = binary add i32 %t12, 1
    store i32 %t13, $y
    %t14 = load u8 $b
    branch %t14, ^cond_then_7, ^cond_else_8

  block ^cond_then_7:
    %t15 = load i32 $x
    store i32 %t15, $cond__3
    jump ^cond_end_9

  block ^cond_else_8:
    %t16 = load i32 $y
    store i32 %t16, $cond__3
    jump ^cond_end_9

  block ^cond_end_9:
    %t17 = load i32 $cond__3
    return i32 %t17
}
function @main() -> i32 [role=entry, binding=strong, keep_alias=yes] {
  block ^entry:
    %t1 = call i32 @f()
    return i32 %t1
}
