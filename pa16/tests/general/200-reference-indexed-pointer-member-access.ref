    %t2 = load ptr $subscript
    %t3 = load i32 %t2
    %t4 = convert sext i64 i32 %t3
    %t5 = binary mul i64 %t4, 4
    %t6 = index i8 [projection=array_element] %t1, %t5
    %t7 = index i8 [projection=field] %t6, 0
    %t8 = load i32 %t7
    return i32 %t8
}
