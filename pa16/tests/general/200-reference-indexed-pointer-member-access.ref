function @read(%elements : ptr, %subscript : ptr [pass=reference]) -> i32 [binding=strong, object=_Z4readP7elementRi] {
  slot $elements : ptr
  slot $subscript : ptr

  block ^entry:
    store ptr %elements, $elements
    store ptr %subscript, $subscript
