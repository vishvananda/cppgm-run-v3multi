  slot $values : obj<4x4>
  slot $subscript : i32
  slot $cond__1 : i32

  block ^entry:
    %t1 = addr $values
    call void @element__element__ov4(%t1, 7)
    store i32 0, $subscript
    %t2 = addr $values
    %t3 = unary decay ptr %t2
    %t4 = addr $subscript
    %t5 = call i32 @read(%t3, %t4)
    %t6 = cmp eq i32 %t5, 7
    branch %t6, ^cond_then_1, ^cond_else_2

  block ^cond_then_1:
    store i32 0, $cond__1
    jump ^cond_end_3

  block ^cond_else_2:
    store i32 1, $cond__1
    jump ^cond_end_3

  block ^cond_end_3:
    %t7 = load i32 $cond__1
    return i32 %t7
}
